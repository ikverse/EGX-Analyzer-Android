<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The app updates itself from its own GitHub releases; nothing else will offer it an update.
         Android still asks the user to allow this app to install apps, and shows its own installer
         dialog for every APK - this permission only makes the app eligible to ask. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Analyses run past the moment the app leaves the foreground, and say so. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Wakes the phone at the minute a scheduled job asks for. Requested rather than the
         auto-granted USE_EXACT_ALARM, which is meant for alarm clocks and calendars; without it
         the app falls back to an inexact alarm that can drift by the better part of an hour,
         which is what every job's grace window exists to absorb. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- An alarm does not survive a reboot. Without this a phone that restarted overnight comes
         back with every schedule silently unbooked. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".EgxApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.EGXAnalyzer">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Holds the process open for the length of a run; it owns no state of its own. -->
        <service
            android:name=".data.AnalysisService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- The four things that mean the schedule needs re-booking: its alarm firing, a reboot,
             an update replacing the app, and the user granting or revoking exact alarms. Not
             exported: three of the four are system broadcasts, which reach a private receiver
             anyway, and the fourth is this app's own alarm. Exporting it would let any app on the
             phone ask this one to wake up and go looking for work. -->
        <receiver
            android:name=".data.ScheduleReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.ikverse.egxanalyzer.RUN_SCHEDULE" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Shares a run's trace. Traces hold prompts, source labels and the model's answer, never
             image bytes or credentials, but they still leave the device only when asked. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.traces"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/trace_paths" />
        </provider>

        <!-- What became of an install. The APK is written into a session the system owns rather
             than shared as a URI, so there is no provider for updates: handing the installer a
             content:// URI failed for three releases on a grant that does not outlive the handoff
             into its staging session, and closed without a word every time. -->
        <receiver
            android:name=".data.UpdateInstallReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.ikverse.egxanalyzer.INSTALL_STATUS" />
            </intent-filter>
        </receiver>

        <!-- Lets whatever the user picks read a report exported as a spreadsheet. Its own authority
             rather than another path on the traces one above: each is named for what it shares, and
             an authority whose name covers two unrelated directories is a grant nobody can reason
             about. Saving to Downloads needs none of this - that goes through MediaStore. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.exports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/export_paths" />
        </provider>
    </application>
</manifest>
