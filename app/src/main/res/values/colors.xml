<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The 5.0 palette's colours that resources need, for the surfaces drawn outside Compose: the
      launcher icon, the shortcut icons and the notifications. The same values as LightPalette in
      ui/theme/Palette.kt, and if those move these move with them.
    -->
    <color name="egx_cobalt">#1E2BFF</color>
    <color name="egx_lime">#C8FF4D</color>
    <color name="egx_coral">#FFB8A3</color>
    <color name="egx_ink">#101828</color>

    <!-- The launcher icon's ground: cobalt, under the lime mark. -->
    <color name="ic_launcher_background">#1E2BFF</color>
    <!--
      The launch screen's ground since 5.0: the app's paper here and its graphite in values-night,
      so a cold start opens on the same ground the first page is drawn on.
    -->
    <color name="splash_background">#EFEDE6</color>
</resources>
