<resources>
    <style name="Theme.EGXAnalyzer" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <!--
          No statusBarColor, navigationBarColor or windowLightStatusBar here. The app is edge to
          edge, so from API 35 the platform ignores the first two outright and draws the bars
          transparent over whatever the app has painted - which is now the page itself, carrying its
          own accent wash up behind the clock. The three values that used to be here painted a
          #0B0F14 strip belonging to neither palette and forced light-on-dark icons on a theme the
          user can set to Light. Which way the glyphs read is decided in `MainActivity`, from the
          app's own resolved theme rather than the system's.
        -->
        <item name="android:windowActionModeOverlay">true</item>
        <!--
          The launch window, which the platform draws itself from API 31 - minSdk here - so this
          needs no library and no code. Without it a cold start showed a blank themed window while
          Telegram came up, which reads as the app having failed to open.
        -->
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_icon</item>
    </style>
</resources>
