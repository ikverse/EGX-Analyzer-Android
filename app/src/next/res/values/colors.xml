<?xml version="1.0" encoding="utf-8"?>
<!--
  What tells the two installs apart before either has drawn a screen.

  The launcher tile cannot carry the difference: its foreground is opaque artwork, so the background
  colour only shows in the parallax band a launcher may crop into. The splash uses the same value
  though, and that is full screen on every launch - so a blue-shifted ground is the one signal that
  is impossible to miss and costs no artwork.

  Shifted towards the redesign's own market blue rather than picked at random.
-->
<resources>
    <color name="ic_launcher_background">#0E2137</color>
    <color name="splash_background">#0E2137</color>
</resources>
